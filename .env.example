# Copy to .env. These are local development defaults, not secrets.
# docker-compose.yml reads these same variables, so the container and the
# application cannot drift apart: change the port here and both follow.

DB_HOST=localhost
DB_PORT=5432
DB_USER=checkout
DB_PASSWORD=checkout
DB_NAME=checkout

PORT=3000

# Reward rule: every COUPON_N-th placed order makes one COUPON_X% coupon available.
COUPON_N=5
COUPON_X=10
